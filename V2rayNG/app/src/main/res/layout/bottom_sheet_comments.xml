<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_rounded_dark"
    android:paddingTop="12dp">

    <!-- مؤشر السحب (Drag Indicator) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"
        android:background="#40FFFFFF"/>

    <!-- عنوان النافذة -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="التعليقات"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"/>

    <!-- قائمة التعليقات المتداخلة -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_comments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

    <!-- قسم كتابة التعليق والرد -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A1D"
        android:elevation="8dp">

        <!-- نص إشعار الرد (يظهر فقط عند الضغط على زر رد) -->
        <TextView
            android:id="@+id/tv_replying_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#262629"
            android:textColor="#2196F3"
            android:textSize="12sp"
            android:padding="8dp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <!-- حقل الإدخال وزر الإرسال -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <EditText
                android:id="@+id/et_comment_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_dark"
                android:hint="إضافة تعليق..."
                android:textColorHint="#80FFFFFF"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:maxLines="4"/>

            <!-- زر الإرسال -->
            <ImageView
                android:id="@+id/btn_send_comment"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:padding="10dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_send"
                app:tint="#2196F3"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
