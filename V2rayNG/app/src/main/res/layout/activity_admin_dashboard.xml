<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" 
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0C">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="لوحة تحكم الإدارة"
        android:textColor="#FF9800"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="20dp"
        android:background="#1A1A1D"/>

    <!-- شريط الأقسام (تم إضافة زر الصلاحيات) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#141417">

        <Button
            android:id="@+id/tab_all_users"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="جميع المستخدمين"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800"
            android:textSize="11sp"/>

        <Button
            android:id="@+id/tab_active_now"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="النشطين"
            android:textColor="#80FFFFFF"
            android:backgroundTint="#252529"
            android:textSize="11sp"
            android:layout_marginHorizontal="4dp"/>

        <Button
            android:id="@+id/tab_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="الإحصائيات"
            android:textColor="#80FFFFFF"
            android:backgroundTint="#252529"
            android:textSize="11sp"/>

        <!-- الزر الجديد الخاص بالصلاحيات -->
        <Button
            android:id="@+id/tab_permissions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="الصلاحيات"
            android:textColor="#80FFFFFF"
            android:backgroundTint="#252529"
            android:textSize="11sp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- قسم جميع المستخدمين -->
    <LinearLayout
        android:id="@+id/layout_all_users_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_total_users"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إجمالي المستخدمين: جاري التحميل..."
            android:textColor="#4CAF50"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:id="@+id/list_all_users"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp"/>
        </ScrollView>
    </LinearLayout>

    <!-- قسم النشطين -->
    <LinearLayout
        android:id="@+id/layout_active_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:gravity="center">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="قسم النشطين سيتم تفعيله في المرحلة القادمة" android:textColor="#80FFFFFF" />
    </LinearLayout>

    <!-- قسم الإحصائيات -->
    <LinearLayout
        android:id="@+id/layout_stats_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:gravity="center">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="قسم الإحصائيات سيتم تفعيله في المرحلة القادمة" android:textColor="#80FFFFFF" />
    </LinearLayout>

    <!-- 🌟 القسم الجديد: صلاحيات نشر الاستوري 🌟 -->
    <LinearLayout
        android:id="@+id/layout_permissions_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1A1A1D"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layoutDirection="rtl">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚙️ صلاحيات النشر (الاستوري)"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <!-- آيدي الحساب -->
                    <EditText
                        android:id="@+id/et_admin_user_id"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_rounded_dark"
                        android:hint="أدخل ID حساب المستخدم"
                        android:textColorHint="#88FFFFFF"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="12dp"/>

                    <!-- الحد اليومي للفيديوهات -->
                    <EditText
                        android:id="@+id/et_admin_video_limit"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_rounded_dark"
                        android:hint="عدد الفيديوهات المسموحة يومياً"
                        android:inputType="number"
                        android:textColorHint="#88FFFFFF"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="12dp"/>

                    <!-- مدة الفيديو بالدقائق -->
                    <EditText
                        android:id="@+id/et_admin_video_duration"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_rounded_dark"
                        android:hint="أقصى مدة للمقطع الواحد (دقائق)"
                        android:inputType="number"
                        android:textColorHint="#88FFFFFF"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="12dp"/>

                    <!-- الحد اليومي للصور -->
                    <EditText
                        android:id="@+id/et_admin_image_limit"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_rounded_dark"
                        android:hint="عدد الصور المسموحة يومياً"
                        android:inputType="number"
                        android:textColorHint="#88FFFFFF"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="16dp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_admin_save_limits"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="حفظ الصلاحيات للمستخدم"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:backgroundTint="#2196F3"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </ScrollView>
    </LinearLayout>

</LinearLayout>
