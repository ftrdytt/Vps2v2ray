<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C"> <!-- لون خلفية عميق وفخم -->

    <!-- 🌟 حاوية الالتقاط (هنا يشتغل الفيديو وتنزل الصور والملصقات) 🌟 -->
    <FrameLayout
        android:id="@+id/story_capture_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">
        
        <!-- مشغل الفيديو الأساسي سيتم إضافته هنا برمجياً لضمان عدم الكراش -->

        <!-- صورة المعاينة (تستخدم كخلفية أو للصور الثابتة قبل التشغيل) -->
        <ImageView
            android:id="@+id/iv_story_video_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- طبقة التظليل العلوية لإبراز الأزرار البيضاء (فخامة التصميم) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="top"
            android:background="#4D000000" /> <!-- تم تغميق الظل قليلاً لزيادة وضوح الأزرار -->

        <!-- حاوية الرسم والملصقات والنصوص (تكون فوق الفيديو دائماً) -->
        <FrameLayout
            android:id="@+id/drawing_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false" />
    </FrameLayout>

    <!-- 🌟 الأزرار العلوية والجانبية (أدوات التعديل العائمة بستايل زجاجي) 🌟 -->
    <RelativeLayout
        android:id="@+id/tools_overlay_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF"
            android:background="@drawable/bg_glass_reactions"
            android:layout_marginTop="40dp"
            android:layout_marginStart="15dp"
            android:padding="10dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="100dp"
            android:layout_marginEnd="15dp">

            <!-- زر إضافة نص (زجاجي) -->
            <FrameLayout
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@drawable/bg_glass_reactions"
                android:layout_marginBottom="15dp">
                
                <ImageView
                    android:id="@+id/btn_add_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#FFFFFF"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"/>
            </FrameLayout>

            <!-- زر إضافة موسيقى (زجاجي) -->
            <FrameLayout
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@drawable/bg_glass_reactions">
                
                <ImageView
                    android:id="@+id/btn_add_music"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="#FFFFFF"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"/>
            </FrameLayout>
        </LinearLayout>

        <!-- 🌟 زر النشر الفخم 🌟 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_publish_story"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="30dp"
            android:text="قصتك"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="25dp"
            app:backgroundTint="#FFFFFF"
            app:icon="@android:drawable/ic_menu_send" 
            app:iconTint="#000000"
            app:iconGravity="textEnd"
            android:paddingStart="20dp"
            android:paddingEnd="15dp"
            android:elevation="8dp"/>
    </RelativeLayout>

    <!-- 🌟 شاشة الأدمن المنبثقة لإضافة موسيقى للسيرفر 🌟 -->
    <FrameLayout
        android:id="@+id/admin_music_upload_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#1A1A1D"
            app:cardElevation="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="25dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="إضافة موسيقى جديدة للسيرفر 🎵"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="20dp"/>
                <EditText
                    android:id="@+id/et_admin_music_title"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="اسم الأغنية أو الترند"
                    android:textColorHint="#88FFFFFF"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_glass_reactions"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:layout_marginBottom="15dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_admin_pick_cover"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="صورة الأغنية"
                        app:cornerRadius="15dp"
                        app:backgroundTint="#33FFFFFF"
                        android:layout_marginEnd="10dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_admin_pick_audio"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="الملف الصوتي"
                        app:cornerRadius="15dp"
                        app:backgroundTint="#33FFFFFF"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_admin_upload_music"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="رفع الموسيقى للسيرفر"
                    app:cornerRadius="15dp"
                    app:backgroundTint="#2196F3"
                    android:layout_marginTop="20dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_admin_close_music"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="إلغاء"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textColor="#FF5252"
                    android:layout_marginTop="5dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- 🌟 شاشة محرر النصوص (تظهر كطبقة شفافة) 🌟 -->
    <FrameLayout
        android:id="@+id/text_editor_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_done_text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="15dp"
            android:text="تم"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="20dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="40dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_glass_reactions"
            android:paddingHorizontal="10dp"
            android:gravity="center">
            
            <ImageView
                android:id="@+id/btn_toggle_text_bg"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#FFFFFF"
                android:padding="8dp"
                android:layout_marginEnd="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"/>
                
            <TextView
                android:id="@+id/btn_toggle_font"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="كلاسيكي"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <EditText
            android:id="@+id/et_story_text_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:hint="اكتب..."
            android:textColorHint="#AAFFFFFF"
            android:textColor="#FFFFFF"
            android:textSize="35sp"
            android:background="@null"
            android:inputType="textMultiLine"
            android:padding="20dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="20dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/color_picker_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"/>
        </HorizontalScrollView>
    </FrameLayout>

    <!-- شاشة التحميل -->
    <FrameLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#2196F3" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="50dp"
            android:text="جاري المعالجة..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </FrameLayout>
</FrameLayout>
