<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- حاوية الاستوري الرئيسية (شاشة كاملة يتم التقاطها كصورة/فيديو) -->
    <FrameLayout
        android:id="@+id/story_capture_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_story_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#000000" />

        <!-- طبقة تظليل خفيفة لجعل النصوص والأدوات واضحة -->
        <View
            android:id="@+id/view_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1A000000" />

        <!-- حاوية الرسم والملصقات والنصوص الحرة (Drag & Drop) -->
        <FrameLayout
            android:id="@+id/drawing_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"/>
    </FrameLayout>

    <!-- الأزرار العلوية الشفافة (زر الإغلاق) -->
    <LinearLayout
        android:id="@+id/top_tools_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="40dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"/>
    </LinearLayout>

    <!-- أدوات الانستغرام (عامودية على اليمين) -->
    <LinearLayout
        android:id="@+id/right_tools_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="end|top"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="15dp"
        android:background="#22000000"
        android:padding="10dp">

        <ImageView
            android:id="@+id/btn_add_text"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_marginBottom="15dp"/>

        <ImageView
            android:id="@+id/btn_add_music"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@android:drawable/ic_media_play"
            app:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_marginBottom="15dp"/>

        <ImageView
            android:id="@+id/btn_add_sticker"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"/>
    </LinearLayout>

    <!-- زر النشر السفلي -->
    <LinearLayout
        android:id="@+id/bottom_tools_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="end|bottom"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_publish_story"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:text="قصتك 🚀"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="30dp"
            app:backgroundTint="#FFFFFF"
            android:paddingStart="25dp"
            android:paddingEnd="25dp"/>
    </LinearLayout>

    <!-- محرر النصوص الاحترافي (يظهر كطبقة شفافة فوق كل شيء عند الكتابة) -->
    <FrameLayout
        android:id="@+id/text_editor_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_done_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="15dp"
            android:text="تم"
            android:textColor="#FFFFFF"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="20dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="45dp"
            android:orientation="horizontal"
            android:gravity="center">
            
            <ImageView
                android:id="@+id/btn_toggle_text_bg"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#FFFFFF"
                android:padding="5dp"
                android:layout_marginEnd="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"/>
                
            <TextView
                android:id="@+id/btn_toggle_font"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="كلاسيكي"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:textStyle="bold"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <EditText
            android:id="@+id/et_story_text_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:hint="اكتب..."
            android:textColorHint="#AAFFFFFF"
            android:textColor="#FFFFFF"
            android:textSize="35sp"
            android:background="@null"
            android:inputType="textMultiLine"
            android:padding="20dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="20dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/color_picker_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"/>
        </HorizontalScrollView>
    </FrameLayout>

    <!-- شاشة التحميل تظهر أثناء الرفع -->
    <FrameLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#2196F3" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="50dp"
            android:text="جاري التجهيز والنشر..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </FrameLayout>
</FrameLayout>
